# Copy this file to .env for local development. Never commit .env.
APP_NAME=Mnemos
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Nebius Token Factory (OpenAI-compatible API)
# Create a key in the Token Factory console.
NEBIUS_TOKEN_FACTORY_KEY=
# Alternative accepted key name:
# NEBIUS_API_KEY=
NEBIUS_TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Confirm these IDs are available to your account in the Token Factory model catalog.
NEBIUS_REASONING_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_FAST_MODEL=nvidia/Nemotron-3-Nano-30B
NEBIUS_REQUEST_TIMEOUT=60

# Tavily web research. Leave blank to disable live search.
TAVILY_API_KEY=

# Local SQLite database. For persistent Docker storage, use the /data volume path.
DATABASE_URL=sqlite:///./mnemos.db

# Frontend-to-backend URL
MNEMOS_API_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# REQUIRED for public deployments: replace with a long, random secret.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MNEMOS_AUTH_SECRET=replace-this-with-a-long-random-secret

# Optional local demo behavior; disabled by default.
MNEMOS_DEMO_MODE=false
